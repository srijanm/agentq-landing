---
import BaseLayout from "../layouts/BaseLayout.astro";

const calendarUrl = "https://calendar.google.com/calendar/u/0/appointments/schedules/AcZssZ2VXsiZVbhgdnhV1tkQ9J6N-roCQlSd4CDDA5BHEcf36xdz-4OJSNM_56LSe5vDu9G6-AZRXkCj";
---

<BaseLayout title="How It Works — AgentQ" description="Supercharged by AI. Launched with humans in the loop. Owned by you.">

  <!-- ═══════════════════════════════════════════
       PAGE HEADER
       ═══════════════════════════════════════════ -->
  <section class="pt-24 pb-8 md:pt-28 md:pb-10">
    <div class="max-w-[1280px] mx-auto px-5 md:px-10">
      <h1 class="type-display text-warm-black mb-4 max-w-[768px]">Supercharged by AI. Launched with humans in the loop. Owned by&nbsp;you.</h1>
      <p class="type-h3 text-warm-mid max-w-[672px]">Bespoke, reliable, software to grow your business. Built&nbsp;Fast.</p>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       SECTION 1: THE FULL JOURNEY
       ═══════════════════════════════════════════ -->
  <section class="py-10 md:py-14 fade-in-section" aria-labelledby="journey-heading">
    <div class="max-w-[1280px] mx-auto px-5 md:px-10">
      <h2 id="journey-heading" class="type-h2 text-warm-black mb-8">Idea to launched product in 3&nbsp;steps.</h2>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="card">
          <span class="type-overline text-stone mb-3 block">Step 1</span>
          <h3 class="type-h4 mb-2">Describe your&nbsp;product.</h3>
          <p class="type-body text-warm-mid">Work with AgentQ's PM agent which turns your idea into a clear build plan before a single line of code is&nbsp;written.</p>
        </div>
        <div class="card">
          <span class="type-overline text-stone mb-3 block">Step 2</span>
          <h3 class="type-h4 mb-2">AI agents build&nbsp;it.</h3>
          <p class="type-body text-warm-mid">A team of specialized AI agents get to work. The backend developer agent designs your database and APIs. Frontend developer builds the UI. Code auditor reviews every&nbsp;line.</p>
        </div>
        <!-- Step 3 stands out -->
        <div class="card" style="background: var(--color-forest); border: 1.5px solid var(--color-warm-black);">
          <span class="type-overline text-white/70 mb-3 block">Step 3</span>
          <h3 class="type-h4 mb-2 text-white">Real developers when you need&nbsp;them.</h3>
          <p class="type-body text-white/80">Hit a wall? Have a question? Want a human to check things over? Developer Assist provides support from real engineers who can see your project and give you specific&nbsp;answers.</p>
        </div>
        <div class="card">
          <span class="type-overline text-stone mb-3 block">Step 4</span>
          <h3 class="type-h4 mb-2">You&nbsp;launch.</h3>
          <p class="type-body text-warm-mid">One-click deployment. Dedicated database. Enterprise security. Clean code which can be understood. Live in&nbsp;days.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       SECTION 2: DEVELOPER ASSIST DEEP DIVE
       ═══════════════════════════════════════════ -->
  <section class="py-10 md:py-14 fade-in-section" aria-labelledby="devassist-deep-heading">
    <div class="max-w-[1280px] mx-auto px-5 md:px-10">
      <h2 id="devassist-deep-heading" class="type-h2 text-warm-black mb-4 max-w-[672px]">Get by with a little help from your&nbsp;friends.</h2>
      <p class="type-body-lg text-warm-mid mb-8 max-w-[768px]">Every plan includes Developer Assist which you can request when you're stuck. A developer reviews your project and helps you apply the fix &amp; answers your questions so you can keep&nbsp;moving.</p>

      <!-- Placeholder for ticket system screenshot -->
      <div class="image-placeholder">
        <p class="type-body-sm text-stone">Developer Assist ticket interface screenshot</p>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       SECTION 3: WHAT DEV ASSIST COVERS
       ═══════════════════════════════════════════ -->
  <section class="py-10 md:py-14 fade-in-section" aria-labelledby="covers-heading">
    <div class="max-w-[1280px] mx-auto px-5 md:px-10">
      <h2 id="covers-heading" class="type-h2 text-warm-black mb-10">Help where you need it, when you need&nbsp;it.</h2>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <div class="card">
          <h3 class="type-h4 mb-2">Solving for your business&nbsp;outcomes.</h3>
          <p class="type-body text-warm-mid mb-4">Developer Assist goes beyond fixing code. Developers help you connect what you're building to the business outcomes you care about. More efficient operations. Better customer&nbsp;experience.</p>
          <p class="type-body font-semibold text-warm-black italic">"We want to reduce the time our dispatch team spends assigning jobs from 2 hours a day to 15 minutes. What's the right way to build the scheduling&nbsp;logic?"</p>
        </div>
        <div class="card">
          <h3 class="type-h4 mb-2">Architecture and&nbsp;planning.</h3>
          <p class="type-body text-warm-mid mb-4">How should your app be structured so it works as your business grows? Developers help with system design, database structure, and the decisions that feel invisible now but become expensive if they're&nbsp;wrong.</p>
          <p class="type-body font-semibold text-warm-black italic">"We're launching with 50 customers but we expect to grow to 500 this year. Will what we're building now handle&nbsp;that?"</p>
        </div>
        <div class="card">
          <h3 class="type-h4 mb-2">Integrations.</h3>
          <p class="type-body text-warm-mid mb-4">Connecting payment gateways, CRMs, analytics tools, or any third-party service. If the service you need has an API, the team helps you connect&nbsp;it.</p>
          <p class="type-body font-semibold text-warm-black italic">"I need Razorpay for payments in India and Stripe for international customers. Can the system automatically route to the right&nbsp;one?"</p>
        </div>
        <div class="card">
          <h3 class="type-h4 mb-2">Code review and&nbsp;security.</h3>
          <p class="type-body text-warm-mid mb-4">Before you go live, a developer reviews the code, checks for security gaps, and makes sure the app is solid enough for real customers with real&nbsp;data.</p>
          <p class="type-body font-semibold text-warm-black italic">"We're about to launch and I want someone experienced to check everything over before my first paying customers use&nbsp;it."</p>
        </div>
        <div class="card">
          <h3 class="type-h4 mb-2">Getting&nbsp;unstuck.</h3>
          <p class="type-body text-warm-mid mb-4">The AI produced something that's not working. Or you've hit a wall and don't know what to do next. Describe the problem. A developer figures it&nbsp;out.</p>
          <p class="type-body font-semibold text-warm-black italic">"I've been going back and forth with the AI on the login flow for two days and it's still not right. I need a human to look at&nbsp;this."</p>
        </div>
        <div class="card">
          <h3 class="type-h4 mb-2">Deployment and&nbsp;launch.</h3>
          <p class="type-body text-warm-mid mb-4">Getting your app live. A developer verifies everything works. You launch with&nbsp;confidence.</p>
          <p class="type-body font-semibold text-warm-black italic">"Everything looks ready. I want someone to do a final check before I send this to&nbsp;customers."</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       SECTION 4: THE TIERS
       ═══════════════════════════════════════════ -->
  <section class="py-10 md:py-14 fade-in-section" aria-labelledby="tiers-heading">
    <div class="max-w-[1280px] mx-auto px-5 md:px-10">
      <h2 id="tiers-heading" class="type-h2 text-warm-black mb-10">Support that scales with&nbsp;you.</h2>

      <div class="grid md:grid-cols-3 gap-4 mb-8">
        <div class="tier-card">
          <p class="type-overline text-stone mb-3">Starter — $20/mo</p>
          <h3 class="type-h4 mb-2">On-demand developer support.</h3>
          <p class="type-body text-warm-mid mb-4">Developer Assist credits included. Submit requests through your dashboard. Get help with bugs, integrations, and code review from developers who can see your&nbsp;project.</p>
          <p class="type-body-sm text-stone">24 hour SLA on Developer&nbsp;Assist.</p>
        </div>
        <div class="tier-card-featured tier-card">
          <p class="type-overline text-forest mb-3">Business — $200/mo</p>
          <h3 class="type-h4 mb-2">Faster response. Direct senior access.</h3>
          <p class="type-body mb-4" style="color: var(--color-stone);">Everything in Starter, with faster turnaround and direct access to senior developers. Dedicated PostgreSQL, unlimited RBAC, type-safe code, and full code&nbsp;history.</p>
          <p class="type-body-sm" style="color: var(--color-warm-mid);">3 hour SLA on Developer&nbsp;Assist.</p>
        </div>
        <div class="tier-card">
          <p class="type-overline text-stone mb-3">Enterprise — $2,000/mo</p>
          <h3 class="type-h4 mb-2">Solutions architects from the ground&nbsp;up.</h3>
          <p class="type-body text-warm-mid mb-4">Dedicated solutions architects involved from the start. Org team collaboration, hands-on training, custom development, and private cloud&nbsp;deployment.</p>
          <p class="type-body-sm text-stone">30 minute SLA on Developer&nbsp;Assist.</p>
        </div>
      </div>

      <a href="/pricing" class="type-body font-medium text-forest hover:text-forest-hover transition-colors">
        See full pricing details <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       SECTION 5: WHY WE BUILT THIS
       ═══════════════════════════════════════════ -->
  <section class="py-10 md:py-14 fade-in-section" aria-labelledby="why-heading">
    <div class="max-w-[1280px] mx-auto px-5 md:px-10">
      <h2 id="why-heading" class="type-h2 text-warm-black mb-6">The data speaks for&nbsp;itself.</h2>
      <div class="max-w-[768px]">
        <p class="type-body text-warm-mid mb-4">We evaluated six AI coding platforms across 68 metrics. No platform scored above 60% on engineering quality &amp; every platform produced software that needs human involvement to reach production. Most platforms leave it for you to figure&nbsp;out.</p>
        <p class="type-body text-warm-mid mb-6">AgentQ apps take about 12 hours to production-ready, compared to 26 for the next closest and 60 for the worst. We built Developer Assist to handle those 12 hours for you. Because even the smallest gap still needs closing, and you shouldn't have to learn to code to close&nbsp;it.</p>
        <a href="/evals" class="type-body font-medium text-forest hover:text-forest-hover transition-colors">
          See the full evaluation <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       SECTION 6: FAQ
       ═══════════════════════════════════════════ -->
  <section class="py-10 md:py-14 fade-in-section" aria-labelledby="faq-heading">
    <div class="max-w-[1280px] mx-auto px-5 md:px-10">
      <div style="border: 1.5px solid var(--color-warm-black); border-radius: var(--radius-card); padding: 28px;">
        <p class="type-overline text-stone mb-4">FAQ</p>
        <h2 id="faq-heading" class="type-h2 text-warm-black mb-10">Common questions.</h2>

        <div class="divide-y divide-warm-black/10">
          <div class="faq-item">
            <button class="faq-question" aria-expanded="false">
              <span>Do I need to manage the developers?</span>
              <svg class="faq-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </button>
            <div class="faq-answer">
              <p class="type-body text-warm-mid pb-2">No. Submit a request. Get a response. That's&nbsp;it.</p>
            </div>
          </div>

          <div class="faq-item">
            <button class="faq-question" aria-expanded="false">
              <span>Is this a chatbot?</span>
              <svg class="faq-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </button>
            <div class="faq-answer">
              <p class="type-body text-warm-mid pb-2">No. Real people. They can see your project and give you specific&nbsp;answers.</p>
            </div>
          </div>

          <div class="faq-item">
            <button class="faq-question" aria-expanded="false">
              <span>Do I get the same developer every time?</span>
              <svg class="faq-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </button>
            <div class="faq-answer">
              <p class="type-body text-warm-mid pb-2">On Priority and Enterprise tiers, you work with a consistent team who knows your&nbsp;project.</p>
            </div>
          </div>

          <div class="faq-item">
            <button class="faq-question" aria-expanded="false">
              <span>What if I need help at 2 AM?</span>
              <svg class="faq-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </button>
            <div class="faq-answer">
              <p class="type-body text-warm-mid pb-2">Requests are handled during business hours. Enterprise plans include extended support&nbsp;windows.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       SECTION 7: CTA
       ═══════════════════════════════════════════ -->
  <section id="closing-cta" class="py-10 md:py-14 fade-in-section" aria-labelledby="closing-heading">
    <div class="max-w-[1280px] mx-auto px-5 md:px-10">
      <div class="cta-container">
        <div class="cta-container-bg" aria-hidden="true">
          <img src="/images/cta-bg.png" alt="">
        </div>
        <div class="relative z-10" style="padding: 28px;">
          <h2 id="closing-heading" class="type-h2 text-warm-black mb-4">It's time to&nbsp;ship.</h2>
          <p class="type-body-lg text-warm-mid mb-8 max-w-[576px]">Build something real. Own your code. Launch with&nbsp;confidence.</p>
          <form class="email-cta-row" novalidate>
            <input type="email" class="email-cta-input" placeholder="Enter your email here" required>
            <a href={calendarUrl} class="btn-primary email-cta-btn" data-calendar-url={calendarUrl}>
              Book a Demo <span aria-hidden="true">&rarr;</span>
            </a>
          </form>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
